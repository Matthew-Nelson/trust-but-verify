-                      disabled={pending}
-                      onClick={() => confirmDelete(r.code)}
-                      className="ml-2 rounded bg-red-800 px-2 py-1 text-white disabled:opacity-60"
-                    >
-                      Confirm delete
-                    </button>
-                  )}
+                  <DeleteControls code={r.code} pending={pending} onConfirm={confirmDelete} />
                 </td>
