                  AND clicked_at >= (((now() AT TIME ZONE 'UTC')::date - ($2::int - 1))::timestamp AT TIME ZONE 'UTC')
                  AND clicked_at <  (((now() AT TIME ZONE 'UTC')::date + 1)::timestamp AT TIME ZONE 'UTC')
                GROUP BY 1) t
-           ORDER BY clicks DESC, name COLLATE "C" ASC LIMIT 5"#,
